{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Move It",
  "version": "0.1.0",
  "identifier": "io.moveit.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:ui",
    "beforeBuildCommand": "npm run prepare:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Move It", "width": 520, "height": 780, "minWidth": 390, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": true, "targets": "all", "createUpdaterArtifacts": true, "shortDescription": "Move your browser between devices", "category": "Utility" },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/0xovo/move-it/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFQUYyOTdEQ0I3RTcwNgpSV1FHNTdmY2wvTHFBcFNEd0NscFI1YStCWUoxelRxYk1NZDdQb1RTc1JJS1AxazMvVnJNdWNwTgo="
    }
  }
}
